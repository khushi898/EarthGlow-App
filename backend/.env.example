PORT=5000
# Checkout uses transactions, so MongoDB must be Atlas or a replica set (see README).
MONGO_URI=mongodb://127.0.0.1:27017/earthglow?replicaSet=rs0
JWT_SECRET=replace_this_with_a_long_random_secret
CLIENT_URL=http://localhost:5173

# Admin account created by npm run seed
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (Resend). Needed for password-reset and login-code emails.
RESEND_API_KEY=
EMAIL_FROM=
OTP_SECRET=replace_this_with_another_long_random_secret

# Set EMAIL_TEST_MODE to true while using Resend's test sender:
# only EMAIL_TEST_TO then receives email, and it signs in with a login code.
EMAIL_TEST_MODE=false
EMAIL_TEST_TO=
